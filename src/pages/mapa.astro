---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import MapSection from '../components/MapSection';
---
<BaseLayout title="Actividad sísmica global">
  <div class="tf-section-head">
    <div>
      <span class="tf-eyebrow">
        <i class="ti ti-activity" aria-hidden="true" style="font-size: 14px;"></i>
        Actividad en vivo
      </span>
      <h1 class="tf-section-title" style="font-size: 26px; margin-top: 8px;">
        Monitoreo sísmico en tiempo real
      </h1>
      <p class="tf-section-sub">
        Exploración interactiva de sismos registrados globalmente y percepción ciudadana.
      </p>
    </div>
  </div>

  <div class="tf-card" style="padding: 16px;">
    <MapSection client:only="react" />
  </div>
</BaseLayout>
