---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeismicMap from '../components/SeismicMap';
---
<BaseLayout title="Inicio">
  <div class="tf-card" style="margin-bottom: 16px;">
    <h1 style="font-size: 25px; font-weight: 700; line-height: 1.3; max-width: 480px; letter-spacing: -0.4px; margin: 0;">
      Monitoreo sísmico para Latinoamérica
    </h1>
    <p style="font-size: 14px; color: var(--tf-text-secondary); max-width: 480px; margin: 8px 0 16px; font-weight: 500;">
      Datos del USGS, reportes ciudadanos y educación sísmica en un solo lugar.
    </p>
  </div>

  <div class="tf-card" style="margin-bottom: 16px; padding: 16px;">
    <SeismicMap client:only="react" />
  </div>

  <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px;">
    <a href="/blog" class="tf-card" style="text-decoration: none; color: inherit; padding: 14px;">
      <i class="ti ti-pencil" style="font-size: 18px; color: var(--tf-accent);"></i>
      <div style="font-size: 13px; font-weight: 700; margin-top: 8px;">Blog</div>
      <div style="font-size: 12px; color: var(--tf-text-secondary); margin-top: 2px; font-weight: 500;">
        Avances del proyecto
      </div>
    </a>
    <a href="/educacion" class="tf-card" style="text-decoration: none; color: inherit; padding: 14px;">
      <i class="ti ti-school" style="font-size: 18px; color: var(--tf-accent);"></i>
      <div style="font-size: 13px; font-weight: 700; margin-top: 8px;">Educación</div>
      <div style="font-size: 12px; color: var(--tf-text-secondary); margin-top: 2px; font-weight: 500;">
        Aprende sismología
      </div>
    </a>
    <a href="/noticias" class="tf-card" style="text-decoration: none; color: inherit; padding: 14px;">
      <i class="ti ti-news" style="font-size: 18px; color: var(--tf-accent);"></i>
      <div style="font-size: 13px; font-weight: 700; margin-top: 8px;">Noticias</div>
      <div style="font-size: 12px; color: var(--tf-text-secondary); margin-top: 2px; font-weight: 500;">
        Actualidad regional
      </div>
    </a>
  </div>
</BaseLayout>
