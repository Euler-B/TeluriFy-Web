---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog')).slice(0, 2);
const eduItems = (await getCollection('education')).slice(0, 2);
---
<BaseLayout title="Inicio · Plataforma Sísmica">
  <!-- Preload map route & data in background while browsing home -->
  <link rel="prefetch" href="/mapa" />

  <!-- Hero Section -->
  <section class="tf-hero-card">
    <div style="max-width: 620px;">
      <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(88, 86, 214, 0.12); color: var(--tf-accent); font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 20px; margin-bottom: 14px;">
        <i class="ti ti-activity" style="font-size: 14px;"></i>
        Red Sísmica Latinoamericana
      </div>
      <h1 style="font-size: 32px; font-weight: 800; line-height: 1.25; letter-spacing: -0.6px; margin: 0 0 12px; color: var(--tf-text);">
        Monitoreo sísmico en tiempo real y percepción ciudadana
      </h1>
      <p style="font-size: 15px; color: var(--tf-text-secondary); line-height: 1.6; font-weight: 500; margin: 0 0 24px;">
        Accede al mapa interactivo de eventos telúricos, reporta cómo sentiste un sismo en tu comunidad y fortalece la prevención sísmica con contenido educativo especializado.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/mapa" class="tf-button-primary">
          <i class="ti ti-map-2" style="font-size: 18px;"></i>
          Explorar Mapa Interactivo
        </a>
        <a href="/educacion" class="tf-button-secondary">
          <i class="ti ti-school" style="font-size: 18px;"></i>
          Aprender Sismología
        </a>
      </div>
    </div>
  </section>

  <!-- Platform Highlights Grid -->
  <section style="margin-bottom: 28px;">
    <h2 style="font-size: 18px; font-weight: 700; letter-spacing: -0.3px; margin: 0 0 14px;">
      Servicios de la plataforma
    </h2>
    <div class="tf-grid-3">
      <div class="tf-card">
        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(88, 86, 214, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
          <i class="ti ti-map-2" style="font-size: 20px; color: var(--tf-accent);"></i>
        </div>
        <h3 style="font-size: 15px; font-weight: 700; margin: 0 0 4px;">Mapa Interactivo</h3>
        <p style="font-size: 13px; color: var(--tf-text-secondary); font-weight: 500; margin: 0 0 12px; line-height: 1.45;">
          Monitoreo con clustering de eventos sísmicos globales integrando la API del USGS.
        </p>
        <a href="/mapa" class="tf-button-secondary" style="padding: 8px 14px; font-size: 12px; margin-top: 4px;">
          <i class="ti ti-map-2" style="font-size: 14px; margin-right: 6px;"></i>
          Ir al mapa
        </a>
      </div>

      <div class="tf-card">
        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(52, 199, 89, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
          <i class="ti ti-message-report" style="font-size: 20px; color: #34C759;"></i>
        </div>
        <h3 style="font-size: 15px; font-weight: 700; margin: 0 0 4px;">Reportes Ciudadanos</h3>
        <p style="font-size: 13px; color: var(--tf-text-secondary); font-weight: 500; margin: 0 0 12px; line-height: 1.45;">
          Envía la intensidad percibida en tu localidad para nutrir el mapa de intensidad sísmica.
        </p>
        <a href="/mapa" class="tf-button-secondary" style="padding: 8px 14px; font-size: 12px; margin-top: 4px;">
          <i class="ti ti-message-report" style="font-size: 14px; margin-right: 6px; color: #34C759;"></i>
          Reportar evento
        </a>
      </div>

      <div class="tf-card">
        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255, 149, 0, 0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
          <i class="ti ti-school" style="font-size: 20px; color: #FF9500;"></i>
        </div>
        <h3 style="font-size: 15px; font-weight: 700; margin: 0 0 4px;">Educación Sísmica</h3>
        <p style="font-size: 13px; color: var(--tf-text-secondary); font-weight: 500; margin: 0 0 12px; line-height: 1.45;">
          Aprende sobre falla de placas, magnitudes sísmicas y protocolos de prevención.
        </p>
        <a href="/educacion" class="tf-button-secondary" style="padding: 8px 14px; font-size: 12px; margin-top: 4px;">
          <i class="ti ti-school" style="font-size: 14px; margin-right: 6px; color: #FF9500;"></i>
          Ver artículos
        </a>
      </div>
    </div>
  </section>

  <!-- Educational & Blog Highlights Carousel Cards -->
  <section style="margin-bottom: 16px;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
      <h2 style="font-size: 18px; font-weight: 700; letter-spacing: -0.3px; margin: 0;">
        Recursos destacados
      </h2>
      <a href="/blog" class="tf-button-secondary" style="padding: 6px 14px; font-size: 12px;">
        Ver todo
      </a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px;">
      {eduItems.map((item) => (
        <a href={`/educacion/${item.id}`} class="tf-card tf-card-link" style="text-decoration: none; color: inherit;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <span style="font-size: 11px; font-weight: 700; background: rgba(88, 86, 214, 0.1); color: var(--tf-accent); padding: 3px 8px; border-radius: 6px; text-transform: uppercase;">
              Educación · {item.data.level}
            </span>
          </div>
          <h3 style="font-size: 15px; font-weight: 700; margin: 0 0 4px; color: var(--tf-text);">
            {item.data.title}
          </h3>
          <p style="font-size: 12px; color: var(--tf-text-secondary); margin: 0; font-weight: 500; line-height: 1.4;">
            {item.data.description}
          </p>
        </a>
      ))}

      {blogPosts.map((post) => (
        <a href={`/blog/${post.id}`} class="tf-card tf-card-link" style="text-decoration: none; color: inherit;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <span style="font-size: 11px; font-weight: 700; background: rgba(52, 199, 89, 0.1); color: #34C759; padding: 3px 8px; border-radius: 6px; text-transform: uppercase;">
              Blog · Novedades
            </span>
          </div>
          <h3 style="font-size: 15px; font-weight: 700; margin: 0 0 4px; color: var(--tf-text);">
            {post.data.title}
          </h3>
          <p style="font-size: 12px; color: var(--tf-text-secondary); margin: 0; font-weight: 500; line-height: 1.4;">
            {post.data.description}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
