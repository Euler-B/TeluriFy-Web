---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityConsole from '../components/ActivityConsole';
import HeroStats from '../components/HeroStats';
import LiveSignal from '../components/LiveSignal';
import NotificationOptIn from '../components/NotificationOptIn';
import WorldRadar from '../components/WorldRadar';
import { getCollection } from 'astro:content';
import { formatRelativeEs } from '../utils/date';

const newsItems = (await getCollection('news'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const eduItems = (await getCollection('education'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const hasEditorialContent = newsItems.length + blogPosts.length + eduItems.length > 0;
---
<BaseLayout
  title="Información sísmica en tiempo real"
  description="Monitoreo sísmico, noticias y educación para Latinoamérica."
>
  <link rel="prefetch" href="/mapa" />

  <section class="tf-hero">
    <div>
      <span class="tf-hero-eyebrow">
        <span class="tf-hero-dot" aria-hidden="true" />
        Monitoreo en tiempo real
      </span>
      <h1 class="tf-hero-title">
        Entiende la Tierra.
        <em>Prepárate mejor.</em>
      </h1>
      <p class="tf-hero-lead">
        Información sísmica clara y oportuna para Latinoamérica. Observa la actividad, conoce sus
        efectos y toma mejores decisiones.
      </p>
      <div class="tf-hero-actions">
        <a href="/mapa" class="tf-button-primary">
          <i class="ti ti-map-2" aria-hidden="true" style="font-size: 17px;"></i>
          Explorar mapa
          <i class="ti ti-arrow-up-right" aria-hidden="true" style="font-size: 15px;"></i>
        </a>
        <a href="/educacion" class="tf-button-ghost">
          Aprender sobre sismos
          <i class="ti ti-chevron-right" aria-hidden="true"></i>
        </a>
      </div>
      <p class="tf-hero-trust">
        <i class="ti ti-shield-check" aria-hidden="true"></i>
        Datos de USGS · Red de percepción ciudadana
      </p>
    </div>

    <div class="tf-hero-visual">
      <WorldRadar client:load compact />
      <div class="tf-hero-caption">
        <i class="ti ti-radio" aria-hidden="true"></i>
        <LiveSignal client:load variant="caption" />
      </div>
    </div>
  </section>

  <HeroStats client:load />

  <section class="tf-section" aria-labelledby="tf-tools-title">
    <div class="tf-section-head">
      <div>
        <span class="tf-section-kicker">Herramientas</span>
        <h2 class="tf-section-title tf-section-title--lg" id="tf-tools-title">
          Todo lo que necesitas para estar informado
        </h2>
      </div>
      <a class="tf-section-link" href="/mapa">
        Ver el mapa <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
      </a>
    </div>

    <div class="tf-feature-grid">
      <a class="tf-feature-card tf-feature-card--primary" href="/mapa">
        <span class="tf-feature-icon"><i class="ti ti-map-2" aria-hidden="true"></i></span>
        <span class="tf-feature-kicker tf-feature-kicker--cyan">Explora</span>
        <h3 class="tf-feature-title">Mapa sísmico en vivo</h3>
        <p class="tf-feature-desc">
          Visualiza los últimos eventos, filtra por magnitud y conoce el impacto en tu región.
        </p>
        <span class="tf-feature-link">
          Abrir mapa <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
        </span>
        <svg class="tf-feature-wave" viewBox="0 0 190 60" fill="none" aria-hidden="true">
          <path
            d="M0 32h34l7-13 9 26 7-21 6 10h28l9-15 8 28 7-19 6 9h61"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
        </svg>
      </a>

      <a class="tf-feature-card" href="/educacion">
        <span class="tf-feature-icon tf-feature-icon--amber"><i class="ti ti-book-2" aria-hidden="true"></i></span>
        <span class="tf-feature-kicker tf-feature-kicker--amber">Aprende</span>
        <h3 class="tf-feature-title">Educación sísmica</h3>
        <p class="tf-feature-desc">
          Conceptos sencillos, guías y recursos para actuar antes, durante y después.
        </p>
        <span class="tf-feature-link">
          Ver recursos <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
        </span>
      </a>

      <a class="tf-feature-card" href="/mapa">
        <span class="tf-feature-icon tf-feature-icon--coral"><i class="ti ti-heart-handshake" aria-hidden="true"></i></span>
        <span class="tf-feature-kicker tf-feature-kicker--coral">Participa</span>
        <h3 class="tf-feature-title">Tu experiencia importa</h3>
        <p class="tf-feature-desc">
          Reporta cómo sentiste un sismo y ayuda a construir una imagen más completa.
        </p>
        <span class="tf-feature-link">
          Reportar evento <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
        </span>
      </a>
    </div>
  </section>

  <ActivityConsole client:load />

  <section class="tf-section" aria-labelledby="tf-editorial-title">
    <div class="tf-section-head">
      <div>
        <span class="tf-section-kicker">Actualidad</span>
        <h2 class="tf-section-title tf-section-title--lg" id="tf-editorial-title">
          Noticias y conocimiento
        </h2>
      </div>
      <a class="tf-section-link" href="/blog">
        Ir al blog <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
      </a>
    </div>

    {hasEditorialContent ? (
      <div class="tf-editorial-grid">
        {newsItems.map((item) => (
          <a
            class="tf-editorial-card tf-editorial-card--media"
            href={item.data.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="tf-editorial-thumb" aria-hidden="true">
              <i class="ti ti-activity"></i>
            </span>
            <span class="tf-editorial-body">
              <span class="tf-editorial-meta">{item.data.category}</span>
              <h3 class="tf-editorial-title">{item.data.title}</h3>
              <span class="tf-editorial-foot">
                <span>{formatRelativeEs(item.data.pubDate)}</span>
                <i class="ti ti-chevron-right" aria-hidden="true"></i>
              </span>
            </span>
          </a>
        ))}

        {blogPosts.map((post) => (
          <a class="tf-editorial-card tf-editorial-card--media" href={`/blog/${post.id}`}>
            <span class="tf-editorial-thumb" aria-hidden="true">
              <i class="ti ti-activity"></i>
            </span>
            <span class="tf-editorial-body">
              <span class="tf-editorial-meta">Blog</span>
              <h3 class="tf-editorial-title">{post.data.title}</h3>
              <span class="tf-editorial-foot">
                <span>{formatRelativeEs(post.data.pubDate)}</span>
                <i class="ti ti-chevron-right" aria-hidden="true"></i>
              </span>
            </span>
          </a>
        ))}

        {eduItems.map((item) => (
          <a class="tf-editorial-card tf-editorial-card--media" href={`/educacion/${item.id}`}>
            <span class="tf-editorial-thumb" aria-hidden="true">
              <i class="ti ti-activity"></i>
            </span>
            <span class="tf-editorial-body">
              <span class="tf-editorial-meta">Educación · Nivel {item.data.level}</span>
              <h3 class="tf-editorial-title">{item.data.title}</h3>
              <span class="tf-editorial-foot">
                <span>Lección {item.data.order}</span>
                <i class="ti ti-chevron-right" aria-hidden="true"></i>
              </span>
            </span>
          </a>
        ))}
      </div>
    ) : (
      <div class="tf-empty-state">
        Aún no hay contenido editorial cargado. La actividad sísmica en vivo sigue disponible en el
        panel superior.
      </div>
    )}
  </section>

  <div id="tf-alertas" class="tf-alertas-anchor">
    <NotificationOptIn client:load />
  </div>
</BaseLayout>
