---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatShortDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="tf-prose">
    <div class="tf-editorial-meta" style="margin-bottom: 12px;">
      <span class="tf-editorial-tag">Blog</span>
      <span class="tf-mono">{formatShortDate(post.data.pubDate)}</span>
    </div>
    <h1 style="font-size: 28px; margin: 0 0 20px;">{post.data.title}</h1>
    <Content />
    <hr />
    <a href="/blog" class="tf-button-secondary">Volver al blog</a>
  </article>
</BaseLayout>
