---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SismoDetail from '../../components/SismoDetail';
import { findSismoById } from '../../services/api';

const { id } = Astro.params;

let sismo = null;

try {
  const signal = AbortSignal.timeout(8000);
  sismo = await findSismoById(String(id), signal);
} catch {
  // sismo remains null — SismoDetail will show the not-found state
}
---
<BaseLayout title={sismo ? `M ${sismo.attributes.magnitude} · ${sismo.attributes.place}` : `Sismo #${id}`}>
  <div style="margin-bottom: 16px;">
    <a href="/mapa" class="tf-button-secondary" style="padding: 6px 14px; font-size: 13px;">
      Volver al mapa
    </a>
  </div>
  <SismoDetail client:load sismoId={String(id)} initialSismo={sismo} />
</BaseLayout>
