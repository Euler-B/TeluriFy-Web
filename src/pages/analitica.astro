---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import SeismicAnalytics from '../components/SeismicAnalytics';
---
<BaseLayout title="Analítica y estadísticas sísmicas">
  <div class="tf-section-head" style="margin-bottom: 20px;">
    <div>
      <span class="tf-eyebrow">
        <i class="ti ti-chart-bar" aria-hidden="true" style="font-size: 14px;"></i>
        Analítica
      </span>
      <h1 class="tf-section-title" style="font-size: 26px; margin-top: 8px;">
        Panorama estadístico de la red
      </h1>
      <p class="tf-section-sub">
        Distribución por estado sísmico, patrones de magnitud y desglose técnico de la red de monitoreo.
      </p>
    </div>
  </div>

  <SeismicAnalytics client:load />
</BaseLayout>
