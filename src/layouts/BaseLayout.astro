---
import '../styles/global.css';
import MobileNav from '../components/MobileNav';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Telurify" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <title>{title} · Telurify</title>
    <script is:inline>
      // Avoid flash of unstyled theme on SSR load
      const rawTheme = localStorage.getItem('tf-theme');
      const validSaved = (rawTheme === 'light' || rawTheme === 'dark') ? rawTheme : null;
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = validSaved || (systemPrefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <header class="tf-site-header" style="border-bottom: 1px solid var(--tf-border); background: var(--tf-header-bg); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 50; transition: background 0.2s ease;">
      <nav class="tf-nav">
        <a href="/" class="tf-nav-logo">Telurify</a>
        <div class="tf-nav-links">
          <a href="/">Inicio</a>
          <a href="/mapa">Mapa</a>
          <a href="/analitica">Analítica</a>
          <a href="/blog">Blog</a>
          <a href="/educacion">Educación</a>
          <a href="/noticias">Noticias</a>
          <ThemeToggle client:load />
        </div>
        <MobileNav client:load />
      </nav>
    </header>
    <main style="max-width: 1100px; margin: 0 auto; padding: 24px 24px 48px;">
      <slot />
    </main>
  </body>
</html>
