---
import '../styles/global.css';
import MobileNav from '../components/MobileNav';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <title>{title} · Telurify</title>
  </head>
  <body>
    <header style="border-bottom: 1px solid var(--tf-border); background: rgba(255,255,255,0.85); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 50;">
      <nav class="tf-nav">
        <a href="/" class="tf-nav-logo">Telurify</a>
        <div class="tf-nav-links">
          <a href="/">Mapa</a>
          <a href="/blog">Blog</a>
          <a href="/educacion">Educación</a>
          <a href="/noticias">Noticias</a>
        </div>
        <MobileNav client:load />
      </nav>
    </header>
    <main style="max-width: 1100px; margin: 0 auto; padding: 24px 24px 48px;">
      <slot />
    </main>
  </body>
</html>
